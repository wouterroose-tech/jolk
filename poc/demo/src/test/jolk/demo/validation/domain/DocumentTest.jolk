~ demo.validation.domain;

+ jolk.test.api.TestCase;

/// # DocumentTest
///
/// @author Wouter Roose
///
class DocumentTest extends TestCase {

    testCanCreateDocument() {
        document = Document #new("MyDocument", "pdf", "A test document", #[1, 2, 3]);

        #assertEquals(document #name, "MyDocument")
        #assertEquals(document #type, "pdf");
        #assertEquals(document #description, "A test document");
        #assertEquals(document #data #size(), 3);
    }

}