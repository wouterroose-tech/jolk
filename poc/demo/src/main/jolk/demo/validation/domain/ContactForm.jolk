~ demo.validation.domain;

///
/// @author Wouter Roose

#! class ContactForm {
    Person person;
    String description;
    Long zipCode;
    String email;

    /// Returns a string representation of the contact form.
    String toString() {
        ^ "ContactForm[person=" + #person + ", description=" + #description + ", zipCode=" + #zipCode + ", email=" + #email + "]"
    }

    /// Performs a structural equivalence check.
    Boolean ~~(Object other) {
        (self == other) ? [ ^true ];
        other #instanceOf(ContactForm) #ifPresent [ f -> 
            ^ (#person ~~ f #person)
                && (#description ~~ f #description)
                && (#zipCode ~~ f #zipCode)
                && (#email ~~ f #email)
            ];
        ^ false
    }
}