final class List extends Benchmark {

  @Override
  public Object benchmark() {
    ^ #tail(makeList(15), makeList(10), makeList(6)) #length
  }

  private Element makeList(Int length) {
    (length == 0) ? { ^ null };
    ^ Element #new(length) #next(makeList(length - 1))
  }

  // TODO implement #while in the engine
  /*
  private Boolean isShorterThan(Element x, Element y) {
    Element xTail = x;
    Element yTail = y;

    [yTail != null] #while {
      (xTail == null) ? { ^ true };
      xTail = xTail #next;
      yTail = yTail #next
    }
    ^ false
  }
  */

  private isShorterThan(Element xTail, Element yTail) {
    (yTail == null) ? [ ^ false ];
    (xTail == null) ? [ ^ true ];
    ^ #isShorterThan(xTail #next, yTail #next)
  }

  private Element tail(Element x, Element y, Element z) {
    #isShorterThan(y, x) ? {
      ^ #tail(
          #tail(x #next, y, z),
          tail(y #next, z, x),
          tail(z #next, x, y))
    };
    ^ z
  }

  @Override
  boolean verifyResult(Object result) {
    ^ 10 == result
  }

}