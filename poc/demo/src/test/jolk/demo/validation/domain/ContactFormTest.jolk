~ demo.validation.domain;

+ jolk.test.api.TestCase;

/// #ContactFormTest
///
/// @author Wouter Roose
///
class ContactFormTest extends TestCase {

    testNew() {
        ^ Assert #that(ContactForm #new #isPresent)
    }

    testNewCompleted() {
        Person person = #getPerson;
        Document document = #getDocument("Test document");
        ContactForm #new
            #id(1)
            #person(person)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description")
            #addDocument(document)
            #ifPresent { f ->
                (f #person == person)
                    && (f #email ~~ "john.doe@example.com")
                    && (f #zipCode == 12345)
                    && (f #description ~~ "Test description");
                }
            #ifEmpty { #fail };
        #success
    }

    // Form should be identical to itself.
    testEquality1() {
        
        ContactForm form = ContactForm #new
            #id(1)
            #person(#getPerson)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description");
        #assertTrue(form == form)
    }

    // Distinct forms should not be identical.
    testEquality2() {
        
        ContactForm formA = ContactForm #new
            #id(1)
            #person(#getPerson)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description");
        ContactForm formB = ContactForm #new
            #id(2)
            #person(#getPerson)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description");
        #assertTrue(formA != formB)
    }

    // Form should be equivalent to itself.
    testEquivalence1() {
        
        ContactForm form = ContactForm #new
            #id(1)
            #person(#getPerson)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description");
        #assertTrue(form ~~ form)
    }

    // Forms with equivalent persons and matching data should be equivalent.
    testEquivalence2() {
        
        ContactForm formA = ContactForm #new
            #id(1)
            #person(#getPerson)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description");
        ContactForm formB = ContactForm #new
            #id(1)
            #person(#getPerson)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description");
        #assertTrue(formA ~~ formB)
    }
    
    // Forms with different data should not be equivalent.
    testEquivalence3() {

        ContactForm formA = ContactForm #new
            #id(1)
            #person(#getPerson)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description A");
        ContactForm formB = ContactForm #new
            #id(2)
            #person(#getPerson)
            #email("john.doe@example.com")
            #zipCode(12345)
            #description("Test description B");
        #assertTrue(formA !~ formB)
    }

    #> Person getPerson() {
        ^ Person #new
            #ssn(12345678939)
            #firstName("John")
            #lastName("Doe");
    }

    #> Document getDocument(String name) {
        ^ Document #new (name, "Document description for: " + name, null)
    }

}