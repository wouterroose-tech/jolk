~ jolk.test;

+ java.lang.System;
+ jolk.test.api.TestSuite;
+ jolk.test.engine.TestRunner;
+ examples.CircleTest;
+ examples.ComplexTest;
+ demonstrators.ArchetypeClassDemonstratorTest;
+ demonstrators.ArchetypeEnumDemonstratorTest;
+ demonstrators.ArchetypeRecordDemonstratorTest;
+ demonstrators.ClosureDemonstratorTest;
+ demonstrators.CollectionLiteralDemonstratorTest;
+ demonstrators.CoreCollectionDemonstratorTest;
+ demonstrators.EqualityDemonstratorTest;
+ demonstrators.ExceptionHandlingDemonstratorTest;
+ demo.validation.domain.PersonTest;
+ demo.validation.domain.ContactFormTest;
+ demo.validation.engine.IssueTest;
+ demo.validation.engine.LevelTest;
+ demo.validation.rules.ContactFormValidationTest;
+ demo.validation.rules.SsnConstraintTest;
+ demo.validation.rules.ZipConstraintTest;
+ mock.MockTest;

/// # DemoTestRunner
///
/// Simulates the JolkTestEngine for the JUnit test framework
///
/// @author Wouter Roose
///
class DemoTestRunner extends TestRunner {

    run() {
        Array<TestSuite> suites = #[];
        suites #add(#examples);
        suites #add(#demonstrators);
        suites #add(#domain);
        suites #add(#engine);
        suites #add(#rules);
        suites #add(#mock);

        super #run(suites);
    }

    TestSuite examples() {
        ^ TestSuite
            #new("examples")
            #addTestCase(CircleTest)
            #addTestCase(ComplexTest)
    }

    TestSuite demonstrators() {
        ^ TestSuite
            #new("demonstrators")
            #addTestCase(ArchetypeClassDemonstratorTest)
            #addTestCase(ArchetypeEnumDemonstratorTest)
            #addTestCase(ArchetypeRecordDemonstratorTest)
            #addTestCase(ClosureDemonstratorTest)
            #addTestCase(CollectionLiteralDemonstratorTest)
            #addTestCase(CoreCollectionDemonstratorTest)
            #addTestCase(EqualityDemonstratorTest)
            #addTestCase(ExceptionHandlingDemonstratorTest)
    }

    TestSuite domain() {
        ^ TestSuite
            #new("demo.validation.domain")
            #addTestCase(PersonTest)
            #addTestCase(ContactFormTest)
    }

    TestSuite engine() {
        // TODO add tests for each engine class
        ^ TestSuite
            #new("demo.validation.engine")
            #addTestCase(LevelTest)
            #addTestCase(IssueTest)
    }

    TestSuite rules() {
        ^ TestSuite
            #new("demo.validation.rules")
            #addTestCase(ZipConstraintTest)
            #addTestCase(SsnConstraintTest)
            #addTestCase(ContactFormValidationTest)
    }

    TestSuite mock() {
        ^ TestSuite
            #new("mock")
            #addTestCase(MockTest)
    }

}