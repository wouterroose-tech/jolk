~ mock;

+ demo.validation.domain.User;
+ demo.validation.services.UserRepository;

/// # UserRepositoryMock
///
/// Implements stubbing for demonstration purposes
/// final implementation will be via a Mockable protocol
///
/// @author Wouter Roose
///
class UserRepositoryMock {

    Map<String, Closure> stubs;
    Map<String, Boolean> calls;
    String pending;

    meta new() {
        ^ super
            #new
            #stubs(#())
            #calls(#())
    }
    
    Object findById(Long id) {
        String selector = "findById(" + id #toString + ")";
        #stubs #at(selector) #ifPresent [ v -> 
            #calls #put(selector , true);
            ^ v #apply ];
        #pending(selector);
        ^ self
    }

    /// Minimalist implementation of the Mockable interface for demonstrator purposes
    
    Boolean verify(String selector, Object... args) {
        ^ #calls
            #at(selector + "(" + args #toString + ")" )
            #isPresent
    }
    
    given(Closure closure) {
        ^ closure #apply
    }

    then(Object returnValue) {
        #stubs #put(#pending, [ returnValue ]);
    }

    throw(MetaClass<Throwable> clazz) {
        #stubs #put(#pending, [ clazz #new #throw ]);
    }
 
}