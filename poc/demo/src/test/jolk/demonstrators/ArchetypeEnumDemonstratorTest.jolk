~ demonstrators;

+ demo.validation.engine.Level;
+ jolk.test.api.TestCase;

/// # ArchetypeEnumDemonstrator
///
/// Demonstrates various Jolk archetype features using the `Level` enum.
///
/// This class showcases:
/// * Accessing enum constants via meta-selectors on the Type identity.
/// * Accessing synthesized enum components (like `#name`).
/// * Declaration of local variables for enums.
/// * Standard protocol messaging (`#toString`).
///
/// @author Wouter Roose
///
public class ArchetypeEnumDemonstratorTest extends TestCase {

    
    testAccessConstant() {
        Level level = Level #ERROR;
        #assertIsPresent(level);
        #assertTrue(level #isPresent);
        #assertEquals("ERROR", level #name);
    }

    testName() {
        #assertEquals("ERROR", Level #ERROR #name);
    }

    testVariable() {
        Level level = Level #WARNING;
        #assertEquals("WARNING", level #name);
    }

    testToString() {
        #assertEquals("ERROR", Level #ERROR #toString);
    }

}