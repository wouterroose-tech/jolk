~ demonstrators;

+ demo.validation.domain.Person;
+ jolk.test.api.TestCase;

///
/// @author Wouter Roose
///
final class ArchetypeClassDemonstratorTest extends TestCase {
    
    testNew() {
        Person p = Person #new;
        #assertIsPresent(p);
        #assertTrue(p != null);
    }

    testCanonicalNew() {
        Person p = Person #new(123456789, "John", "Doe");
        #assertEquals(123456789, p #ssn);
        #assertEquals("John", p #firstName);
        #assertEquals("Doe", p #lastName);
    }

    testFluid() {
        String s =  Person #new
            #ssn(987654321)
            #firstName("Jane")
            #lastName("Doe")
            #name;
        #assertEquals("Jane Doe", s);
    }
    
    testRunToString() {
        Person person = Person #new(123456789, "John", "Doe");
        #assertEquals("Person[ssn=123456789, firstName=John, lastName=Doe]", person #toString);
    }

}