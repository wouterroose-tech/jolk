~ mock;

+ demo.validation.domain.User;
+ demo.validation.services.UserManager;
+ demo.validation.services.UserRepository;

/// # MockTest
///
/// Demonstrator for the Mockable interface
///
/// @author Wouter Roose
///
class MockTest extends TestCase {
        
    UserRepository repo;

    @Test
    testGivenThenReturn() {
        repo = #mock(UserRepository);
        User alice  = User #new(42, "Alice");
        #given [repo #findById(42)] #then(alice);

        // test & verify
        User user = UserManager #new(repo) #find(42);
        #assertIsPresent(user);
        #assertEquals("Alice", user #name);
        #assertTrue(repo #verify("findById", 42));
    }

    @Test
    testGivenThenThrow() {
        repo = #mock(UserRepository);
        #given [repo #findById(0)] #throw(RuntimeException);

        // test & verify
        Closure find = [ UserManager #new(repo) #find(0)];
        #assertThrows(find, RuntimeException );
        #assertTrue(repo #verify("findById", 0));
    }
    
    @Test
    testMockCreation() {
        UserRepository repo = #mock(UserRepository);
        #assertIsPresent(repo);
    }

    /// Simulate mock API
    <T> T mock(MetaClass<T> clazz) {
        clazz == UserRepository ? [ ^ UserRepositoryMock #new ] ;
        RuntimeException #new("Unnsupported class for mocking: " + clazz);
    }
    
    UserRepositoryMock given(Closure closure) {
        ^ repo #given(closure);
    }

}