~ demonstrators;

+ demo.validation.domain.Person;
+ jolk.test.api.TestCase;

///
/// @author Wouter Roose
///
final class ClassTest extends TestCase {
    
    testNew() {
        person = Person #new;
        #assertIsPresent(person);
        #assertTrue(person != null);
    }

    testCanonicalNew() {
        person = Person #new(123456789, "John", "Doe");
        #assertEquals(123456789, person #ssn);
        #assertEquals("John", person #firstName);
        #assertEquals("Doe", person #lastName);
    }

    testFluid() {
        string =  Person #new
            #ssn(987654321)
            #firstName("Jane")
            #lastName("Doe")
            #name;
        #assertEquals("Jane Doe", string);
    }
    
    testRunToString() {
        person = Person #new(123456789, "John", "Doe");
        #assertEquals("Person[ssn=123456789, firstName=John, lastName=Doe]", person #toString);
    }

}