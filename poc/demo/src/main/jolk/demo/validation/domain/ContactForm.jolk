~ demo.validation.domain;

+ java.util.List;

///
/// @author Wouter Roose

#! class ContactForm {
    Long id;
    Person person;
    Long zipCode;
    String email;
    String description;
    List[Document] documents = #[];

    /// Returns a string representation of the contact form.
    String toString() {
        ^ "ContactForm[id=" + #id + ", person=" + #person + ", description=" + #description + "]"
    }

    /// Performs a structural equivalence check.
    Boolean ~~(Object other) {
        (self == other) ? { ^ true };
        other #instanceOf(ContactForm) #ifPresent { f -> 
            ^ (#id == f #id)
                && (#person ~~ f #person)
                && (#zipCode == f #zipCode)
        };
        ^ false
    }

    addDocument(Document document) {
        #documents #add(document)
    }

}