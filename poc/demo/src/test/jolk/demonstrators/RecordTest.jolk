~ demonstrators;

+ demo.validation.engine.Issue;
+ demo.validation.engine.Level;
+ jolk.test.api.TestCase;

///
/// @author Wouter Roose
///
public class RecordTest extends TestCase {

    @Test
    testCanonicalNew() {
        Issue issue = Issue #new("Identity", "Validation failed", Level #ERROR);
        #assertIsPresent(issue);
        #assertTrue(issue #isPresent);
        #assertEquals("Identity", issue #subject);
        #assertEquals("Validation failed", issue #message);
        #assertEquals(Level #ERROR, issue #level);
    }

    @Test
    testAccessors() {
        Issue issue = Issue #new("Subject", "Message Content", Level #WARNING);
        #assertEquals("Message Content", issue #message);
        #assertEquals(Level #WARNING, issue #level);
    }

    @Test
    testRunToString() {
        Issue issue = Issue #new("Target", "String representation", Level #INFO);
        #assertEquals("Issue[subject=Target, message=String representation, level=INFO]", issue #toString);
    }
}
