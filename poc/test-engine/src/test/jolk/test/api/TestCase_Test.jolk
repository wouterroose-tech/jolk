~ jolk.test.api;

/// # TestCase_Test
///
/// Self-testing validation for the Jolk test protocol.
///
/// This class verifies the `TestCase` protocol by running assertion patterns, 
/// failure injections, and condition checks against the testing framework itself,
/// all within Jolk's message-passing paradigm.
///
/// @author Wouter Roose
///
class TestCase_Test extends TestCase {

    @Test
    testSuccess() {
        #success
    }

    @Test
    testFail() {
        // uncomment if wanting to see a failing test in MVN or IDE
        //#fail
    }

    @Test
    testDisabled() {
        // uncomment if wanting to see a disabled test in MVN or IDE
        //#disabled
    }

    @Test
    testAssertFailure() {
        #assertFailure [ #fail ]
    }

    @Test
    testAssertTrue_success() {
        #assertTrue(true)
    }
    
    @Test
    testAssertTrue_failure() {
        #assertFailure [ #assertTrue(false) ]
    }
    
    /// Test failure of #assertSame
    @Test
    testAssertSame_success() {
        String same = "same";
        #assertSame(same, same)
    }

    /// Test failure of #assertSame
    @Test
    testAssertSame_failure() {
        #assertFailure [ #assertSame("~~", "==") ]
    }
    
    @Test
    testAssertEquals_success() {
        #assertEquals("Hello", "Hello")
    }

    @Test
    testAssertEquals_failure() {
        #assertFailure [ #assertEquals("Hello", "World") ]
    }

    @Test
    testAssertIsPresent_success() {
        #assertIsPresent("Hello")
    }

    @Test
    testAssertIsPresent_failure() {
        #assertFailure [ #assertIsPresent(null) ]
    }

    @Test
    testAssertThrows() {
        #assertThrows(self ##fail, RuntimeException)
    }
    
    #> assertFailure(Closure test) {
        test #catch [ AssertionSignal e -> ^ #success() ];
        #fail
    }
}